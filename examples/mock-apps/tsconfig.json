{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@makermods/arm-core": [
        "../../packages/arm-core/src/index.ts"
      ],
      "@makermods/arm-core/*": [
        "../../packages/arm-core/src/*.ts"
      ],
      "@makermods/metal-arm": [
        "../../packages/metal-arm/src/index.ts"
      ],
      "@makermods/metal-arm/*": [
        "../../packages/metal-arm/src/*.ts"
      ],
      "@makermods/maker-arm": [
        "../../packages/maker-arm/src/index.ts"
      ],
      "@makermods/maker-arm/*": [
        "../../packages/maker-arm/src/*.ts"
      ],
      "@makermods/so101": [
        "../../packages/so101/src/index.ts"
      ],
      "@makermods/so101/*": [
        "../../packages/so101/src/*.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "../../e2e/**/*.ts",
    "../../playwright.config.ts"
  ],
  "exclude": [
    "playground",
    "../../e2e/playground.spec.ts",
    "../../e2e/dream-server.ts"
  ]
}
